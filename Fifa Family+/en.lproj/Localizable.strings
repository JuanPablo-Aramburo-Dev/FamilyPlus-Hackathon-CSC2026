about.title = "About Us";
about.mission.title = "Our Mission";
about.mission.body = "At Family+, we believe football should be an accessible, safe, and enjoyable experience for all families. Our goal is to connect fans with family-friendly areas, inclusive services, and unique experiences inside and outside the 2026 World Cup stadiums.";
about.history.title = "Our Story";
about.history.body = "Family+ began as a university project at CETYS Universidad, driven by the vision of creating an app that promotes inclusion and comfort for families at major sporting events.";
about.team.title = "Our Team";
about.team.body = "We are a multidisciplinary team of students passionate about technology, design, and sports. We combine our skills to build a tool that brings families together through football.";
about.backToHome = "Back to Home";

