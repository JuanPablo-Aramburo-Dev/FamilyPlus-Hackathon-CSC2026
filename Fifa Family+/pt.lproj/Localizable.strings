   ========================= */
about.title = "Sobre nós";
about.mission.title = "Nossa Missão";
about.mission.body = "Na Family+, acreditamos que o futebol deve ser uma experiência acessível, segura e agradável para todas as famílias. Nosso objetivo é conectar os torcedores a espaços familiares, serviços inclusivos e experiências únicas dentro e fora dos estádios da Copa do Mundo de 2026.";
about.history.title = "Nossa História";
about.history.body = "A Family+ nasceu como um projeto universitário no CETYS Universidad, impulsionado pela visão de criar um aplicativo que promova inclusão e conforto para as famílias em grandes eventos esportivos.";
about.team.title = "Nossa Equipe";
about.team.body = "Somos uma equipe multidisciplinar de estudantes apaixonados por tecnologia, design e esporte. Combinamos nossas habilidades para desenvolver uma ferramenta que aproxima as famílias por meio do futebol.";
