about.title = "À propos de nous";
about.mission.title = "Notre mission";
about.mission.body = "Chez Family+, nous croyons que le football doit être une expérience accessible, sûre et agréable pour toutes les familles. Notre objectif est de connecter les supporters à des espaces familiaux, des services inclusifs et des expériences uniques à l'intérieur et à l'extérieur des stades de la Coupe du Monde 2026.";
about.history.title = "Notre histoire";
about.history.body = "Family+ est né comme un projet universitaire à l'Université CETYS, inspiré par la vision de créer une application qui favorise l'inclusion et le confort des familles lors de grands événements sportifs.";
about.team.title = "Notre équipe";
about.team.body = "Nous sommes une équipe multidisciplinaire d'étudiants passionnés par la technologie, le design et le sport. Nous combinons nos compétences pour développer un outil qui unit les familles à travers le football.";
about.backToHome = "Retour à l'accueil";

